diff -ruN a/bfd/config.bfd b/bfd/config.bfd
--- a/bfd/config.bfd	2026-11-11 11:46:05.673242682 -0500
+++ b/bfd/config.bfd	2026-11-11 11:46:05.674080482 -0500
@@ -591,6 +591,11 @@
     targ_defvec=i386_elf32_vec
     targ_selvecs="iamcu_elf32_vec i386_coff_vec"
     ;;
+  i[3-7]86-*-fluxos*)
+    targ_defvec=i386_elf32_vec
+    targ_selvecs=
+    targ64_selvecs=x86_64_elf64_vec
+    ;;
   i[3-7]86-*-solaris2*)
     targ_defvec=i386_elf32_sol2_vec
     targ_selvecs="iamcu_elf32_vec i386_coff_vec i386_pei_vec"
@@ -681,6 +686,11 @@
     targ_selvecs="i386_elf32_vec iamcu_elf32_vec"
     want64=true
     ;;
+  x86_64-*-fluxos*)
+    targ_defvec=x86_64_elf64_vec
+    targ_selvecs=i386_elf32_vec
+    want64=true
+    ;;
   x86_64-*-elf* | x86_64-*-rtems* | x86_64-*-fuchsia | x86_64-*-genode*)
     targ_defvec=x86_64_elf64_vec
     targ_selvecs="i386_elf32_vec iamcu_elf32_vec x86_64_elf32_vec"
diff -ruN a/config.sub b/config.sub
--- a/config.sub	2026-11-11 11:46:05.673283153 -0500
+++ b/config.sub	2026-11-11 11:46:05.674211226 -0500
@@ -1766,7 +1766,7 @@
 	     | onefs* | tirtos* | phoenix* | fuchsia* | redox* | bme* \
 	     | midnightbsd* | amdhsa* | unleashed* | emscripten* | wasi* \
 	     | nsk* | powerunix* | genode* | zvmoe* | qnx* | emx* | zephyr* \
-	     | fiwix* | mlibc* | cos* | mbr* )
+	     | fiwix* | mlibc* | cos* | mbr* | fluxos* )
 		;;
 	# This one is extra strict with allowed versions
 	sco3.2v2 | sco3.2v[4-9]* | sco5v6*)
diff -ruN a/gas/configure.tgt b/gas/configure.tgt
