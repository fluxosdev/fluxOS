diff -ruN a/ld/configure.tgt b/ld/configure.tgt
--- a/ld/configure.tgt	2026-11-11 11:46:05.673340288 -0500
+++ b/ld/configure.tgt	2026-11-11 11:46:05.674147492 -0500
@@ -402,6 +402,10 @@
 i[3-7]86-*-elfiamcu)	targ_emul=elf_iamcu
 			targ_extra_emuls=elf_i386
 			;;
+i[3-7]86-*-fluxos*)	targ_emul=elf_i386
